from __future__ import annotations

import base64
import os
from pathlib import Path

from cryptography.fernet import Fernet, InvalidToken
from cryptography.hazmat.primitives import hashes
from cryptography.hazmat.primitives.kdf.pbkdf2 import PBKDF2HMAC


TAMANHO_SALT = 16
ITERACOES_PBKDF2 = 600_000


def gerar_chave(senha: str, salt: bytes) -> bytes:
    """
    Deriva uma chave criptográfica a partir da senha.
    """
    if not senha:
        raise ValueError("A senha não pode ser vazia.")

    kdf = PBKDF2HMAC(
        algorithm=hashes.SHA256(),
        length=32,
        salt=salt,
        iterations=ITERACOES_PBKDF2,
    )

    return base64.urlsafe_b64encode(
        kdf.derive(senha.encode("utf-8"))
    )


def criptografar_zip(
    caminho_zip: str | Path,
    caminho_saida: str | Path,
    senha: str,
) -> None:
    """
    Criptografa um arquivo ZIP e salva o resultado como texto Base64.

    O arquivo gerado contém:
    - salt;
    - dados criptografados;
    - tudo codificado em Base64.
    """
    caminho_zip = Path(caminho_zip)
    caminho_saida = Path(caminho_saida)

    if not caminho_zip.exists():
        raise FileNotFoundError(
            f"Arquivo ZIP não encontrado: {caminho_zip}"
        )

    if caminho_zip.suffix.lower() != ".zip":
        raise ValueError("O arquivo de entrada precisa ser um ZIP.")

    dados_originais = caminho_zip.read_bytes()

    salt = os.urandom(TAMANHO_SALT)
    chave = gerar_chave(senha, salt)

    criptografador = Fernet(chave)
    dados_criptografados = criptografador.encrypt(dados_originais)

    # O salt precisa acompanhar os dados para recriar a chave posteriormente.
    pacote = salt + dados_criptografados

    texto_base64 = base64.b64encode(pacote).decode("ascii")

    caminho_saida.write_text(
        texto_base64,
        encoding="utf-8",
    )

    print(f"Arquivo criptografado criado em: {caminho_saida}")


def descriptografar_zip(
    caminho_criptografado: str | Path,
    caminho_zip_saida: str | Path,
    senha: str,
) -> None:
    """
    Lê o texto Base64, descriptografa os dados e recupera o ZIP original.
    """
    caminho_criptografado = Path(caminho_criptografado)
    caminho_zip_saida = Path(caminho_zip_saida)

    if not caminho_criptografado.exists():
        raise FileNotFoundError(
            f"Arquivo criptografado não encontrado: "
            f"{caminho_criptografado}"
        )

    texto_base64 = caminho_criptografado.read_text(
        encoding="utf-8"
    ).strip()

    try:
        pacote = base64.b64decode(
            texto_base64,
            validate=True,
        )
    except ValueError as erro:
        raise ValueError(
            "O arquivo não contém um Base64 válido."
        ) from erro

    if len(pacote) <= TAMANHO_SALT:
        raise ValueError("Arquivo criptografado inválido ou incompleto.")

    salt = pacote[:TAMANHO_SALT]
    dados_criptografados = pacote[TAMANHO_SALT:]

    chave = gerar_chave(senha, salt)
    criptografador = Fernet(chave)

    try:
        dados_originais = criptografador.decrypt(
            dados_criptografados
        )
    except InvalidToken as erro:
        raise ValueError(
            "Senha incorreta ou arquivo criptografado corrompido."
        ) from erro

    caminho_zip_saida.write_bytes(dados_originais)

    print(f"ZIP recuperado em: {caminho_zip_saida}")


