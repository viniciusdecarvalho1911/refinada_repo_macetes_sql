from __future__ import annotations

import base64
import getpass
import json
import os

import struct
from pathlib import Path

from cryptography.fernet import Fernet, InvalidToken
from cryptography.hazmat.primitives import hashes
from cryptography.hazmat.primitives.kdf.pbkdf2 import PBKDF2HMAC


# Identifica o formato do arquivo criptografado.
ASSINATURA = b"ARQUIVO_CRIPTO_V1"

TAMANHO_SALT = 16
ITERACOES_PBKDF2 = 600_000

# Número inteiro de 4 bytes usado para armazenar
# o tamanho dos metadados.
FORMATO_TAMANHO_METADATA = ">I"
TAMANHO_CABECALHO_METADATA = struct.calcsize(
    FORMATO_TAMANHO_METADATA
)


def gerar_chave(senha: str, salt: bytes) -> bytes:
    """
    Deriva uma chave Fernet de 32 bytes a partir da senha.


    A mesma senha e o mesmo salt sempre produzem a mesma chave.
    """
    if not senha:
        raise ValueError("A senha não pode ser vazia.")

    kdf = PBKDF2HMAC(
        algorithm=hashes.SHA256(),
        length=32,
        salt=salt,
        iterations=ITERACOES_PBKDF2,
    )

    chave = kdf.derive(senha.encode("utf-8"))

    return base64.urlsafe_b64encode(chave)


def montar_pacote(
    caminho_arquivo: Path,
    senha: str,
) -> bytes:
    """
    Lê o arquivo e monta o pacote criptografado.

    Estrutura antes do Base64:

        assinatura
        salt
        tamanho dos metadados
        metadados criptografados
        conteúdo criptografado
    """
    dados_originais = caminho_arquivo.read_bytes()

    salt = os.urandom(TAMANHO_SALT)
    chave = gerar_chave(senha, salt)
    fernet = Fernet(chave)

    metadata = {
        "nome_original": caminho_arquivo.name,
        "tamanho_original": len(dados_originais),
        "versao": 1,
    }

    metadata_json = json.dumps(
        metadata,
        ensure_ascii=False,
    ).encode("utf-8")

    metadata_criptografada = fernet.encrypt(
        metadata_json
    )

    conteudo_criptografado = fernet.encrypt(
        dados_originais
    )

    tamanho_metadata = struct.pack(
        FORMATO_TAMANHO_METADATA,
        len(metadata_criptografada),
    )

    return (
        ASSINATURA
        + salt
        + tamanho_metadata
        + metadata_criptografada
        + conteudo_criptografado
    )


def criptografar_arquivo(
    caminho_arquivo: str | Path,
    caminho_txt_saida: str | Path | None,
    senha: str,
) -> Path:
    """
    Criptografa qualquer arquivo e salva o resultado em um TXT Base64.

    Exemplo:

        relatório.xlsx
            ↓
        relatório.xlsx.criptografado.txt
    """
    caminho_arquivo = Path(caminho_arquivo).expanduser().resolve()

    if not caminho_arquivo.exists():
        raise FileNotFoundError(
            f"Arquivo não encontrado: {caminho_arquivo}"
        )

    if not caminho_arquivo.is_file():
        raise ValueError(
            "O caminho informado precisa apontar para um arquivo."
        )

    if caminho_txt_saida is None:
        caminho_txt_saida = caminho_arquivo.with_name(
            caminho_arquivo.name + ".criptografado.txt"
        )
    else:
        caminho_txt_saida = (
            Path(caminho_txt_saida)
            .expanduser()
            .resolve()
        )

    pacote = montar_pacote(
        caminho_arquivo=caminho_arquivo,
        senha=senha,
    )

    texto_base64 = base64.b64encode(
        pacote
    ).decode("ascii")

    caminho_txt_saida.parent.mkdir(
        parents=True,
        exist_ok=True,
    )

    caminho_txt_saida.write_text(
        texto_base64,
        encoding="utf-8",
    )

    return caminho_txt_saida


def ler_pacote_base64(
    caminho_txt: Path,
) -> bytes:
    """
    Lê e valida o Base64 armazenado no arquivo TXT.
    """
    texto_base64 = caminho_txt.read_text(
        encoding="utf-8"
    ).strip()

    if not texto_base64:
        raise ValueError(
            "O arquivo criptografado está vazio."
        )

    try:
        return base64.b64decode(
            texto_base64,
            validate=True,
        )
    except (ValueError, base64.binascii.Error) as erro:
        raise ValueError(
            "O arquivo não contém um Base64 válido."
        ) from erro


def separar_pacote(
    pacote: bytes,
) -> tuple[bytes, bytes, bytes]:
    """
    Separa salt, metadados criptografados e conteúdo criptografado.
    """
    tamanho_minimo = (
        len(ASSINATURA)
        + TAMANHO_SALT
        + TAMANHO_CABECALHO_METADATA
    )

    if len(pacote) <= tamanho_minimo:
        raise ValueError(
            "Arquivo criptografado inválido ou incompleto."
        )

    if not pacote.startswith(ASSINATURA):
        raise ValueError(
            "O arquivo não possui uma assinatura reconhecida."
        )

    posicao = len(ASSINATURA)

    salt = pacote[
        posicao:posicao + TAMANHO_SALT
    ]
    posicao += TAMANHO_SALT

    bytes_tamanho_metadata = pacote[
        posicao:posicao + TAMANHO_CABECALHO_METADATA
    ]
    posicao += TAMANHO_CABECALHO_METADATA

    tamanho_metadata = struct.unpack(
        FORMATO_TAMANHO_METADATA,
        bytes_tamanho_metadata,
    )[0]

    if tamanho_metadata <= 0:
        raise ValueError(
            "Tamanho dos metadados inválido."
        )

    fim_metadata = posicao + tamanho_metadata

    if fim_metadata >= len(pacote):
        raise ValueError(
            "Arquivo criptografado incompleto."
        )

    metadata_criptografada = pacote[
        posicao:fim_metadata
    ]

    conteudo_criptografado = pacote[
        fim_metadata:
    ]

    return (
        salt,
        metadata_criptografada,
        conteudo_criptografado,
    )


def descriptografar_arquivo(
    caminho_txt_criptografado: str | Path,
    pasta_saida: str | Path | None,
    senha: str,
    sobrescrever: bool = False,
) -> Path:
    """
    Descriptografa o TXT e recupera o arquivo original.

    O nome e a extensão originais são restaurados automaticamente.
    """
    caminho_txt = (
        Path(caminho_txt_criptografado)
        .expanduser()
        .resolve()
    )

    if not caminho_txt.exists():
        raise FileNotFoundError(
            f"Arquivo criptografado não encontrado: {caminho_txt}"
        )

    if not caminho_txt.is_file():
        raise ValueError(
            "O caminho criptografado precisa ser um arquivo."
        )

    pacote = ler_pacote_base64(caminho_txt)

    (
        salt,
        metadata_criptografada,
        conteudo_criptografado,
    ) = separar_pacote(pacote)

    chave = gerar_chave(
        senha=senha,
        salt=salt,
    )

    fernet = Fernet(chave)

    try:
        metadata_json = fernet.decrypt(
            metadata_criptografada
        )

        dados_originais = fernet.decrypt(
            conteudo_criptografado
        )

    except InvalidToken as erro:
        raise ValueError(
            "Senha incorreta ou arquivo criptografado corrompido."
        ) from erro

    try:
        metadata = json.loads(
            metadata_json.decode("utf-8")
        )
    except (UnicodeDecodeError, json.JSONDecodeError) as erro:
        raise ValueError(
            "Não foi possível interpretar os metadados."
        ) from erro

    nome_original = metadata.get("nome_original")

    if not nome_original:
        raise ValueError(
            "O nome original não foi encontrado nos metadados."
        )

    # Path(...).name evita que um nome malicioso
    # grave arquivos fora da pasta escolhida.
    nome_original = Path(nome_original).name

    if pasta_saida is None:
        pasta_saida = caminho_txt.parent
    else:
        pasta_saida = (
            Path(pasta_saida)
            .expanduser()
            .resolve()
        )

    pasta_saida.mkdir(
        parents=True,
        exist_ok=True,
    )

    caminho_saida = pasta_saida / nome_original

    if caminho_saida.exists() and not sobrescrever:
        caminho_saida = gerar_nome_disponivel(
            caminho_saida
        )

    tamanho_esperado = metadata.get(
        "tamanho_original"
    )

    if (
        tamanho_esperado is not None
        and len(dados_originais) != tamanho_esperado
    ):
        raise ValueError(
            "O tamanho recuperado é diferente do tamanho original. "
            "O arquivo pode estar corrompido."
        )

    caminho_saida.write_bytes(
        dados_originais
    )

    return caminho_saida


def gerar_nome_disponivel(
    caminho: Path,
) -> Path:
    """
    Evita sobrescrever um arquivo existente.

    Exemplo:

        relatorio.xlsx
        relatorio_recuperado_1.xlsx
        relatorio_recuperado_2.xlsx
    """
    pasta = caminho.parent
    sufixo = caminho.suffix
    nome_base = caminho.stem

    contador = 1

    while True:
        candidato = pasta / (
            f"{nome_base}_recuperado_{contador}{sufixo}"
        )

        if not candidato.exists():
            return candidato

        contador += 1


def solicitar_caminho(
    mensagem: str,
) -> Path:
    """
    Solicita um caminho e remove aspas inseridas pelo usuário.
    """
    valor = input(mensagem).strip()

    valor = valor.strip('"').strip("'")

    return Path(valor).expanduser()


def menu() -> None:
    """
    Menu simples para criptografar e descriptografar arquivos.
    """
    print()
    print("=" * 60)
    print("CRIPTOGRAFADOR DE ARQUIVOS")
    print("=" * 60)
    print("1 - Criptografar arquivo")
    print("2 - Descriptografar arquivo")
    print("0 - Sair")
    print()

    opcao = input("Escolha uma opção: ").strip()

    if opcao == "1":
        caminho_entrada = solicitar_caminho(
            "Caminho do arquivo que será criptografado: "
        )

        senha = getpass.getpass(
            "Digite a senha: "
        )

        confirmacao = getpass.getpass(
            "Confirme a senha: "
        )

        if senha != confirmacao:
            raise ValueError(
                "As senhas digitadas são diferentes."
            )

        caminho_saida = criptografar_arquivo(
            caminho_arquivo=caminho_entrada,
            caminho_txt_saida=None,
            senha=senha,
        )

        print()
        print("Arquivo criptografado com sucesso.")
        print(f"Saída: {caminho_saida}")

    elif opcao == "2":
        caminho_entrada = solicitar_caminho(
            "Caminho do TXT criptografado: "
        )

        pasta_digitada = input(
            "Pasta de saída "
            "(pressione Enter para usar a mesma pasta): "
        ).strip()

        pasta_saida = (
            Path(pasta_digitada)
            if pasta_digitada
            else None
        )

        senha = getpass.getpass(
            "Digite a senha: "
        )

        caminho_recuperado = descriptografar_arquivo(
            caminho_txt_criptografado=caminho_entrada,
            pasta_saida=pasta_saida,
            senha=senha,
            sobrescrever=False,
        )

        print()
        print("Arquivo recuperado com sucesso.")
        print(f"Saída: {caminho_recuperado}")

    elif opcao == "0":
        print("Programa encerrado.")

    else:
        raise ValueError(
            "Opção inválida."
        )


if __name__ == "__main__":
    try:
        menu()

    except KeyboardInterrupt:
        print("\nOperação cancelada pelo usuário.")

    except Exception as erro:
        print()
        print(f"Erro: {erro}")




