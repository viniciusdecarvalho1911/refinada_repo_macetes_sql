"""
Aplicativo gráfico para:

1. Selecionar uma pasta.
2. Compactar todo o conteúdo em ZIP.
3. Criptografar com uma senha usando AES-256-GCM.
4. Salvar o resultado como uma sequência somente de números.
5. Restaurar a pasta usando a mesma senha.

Dependência:
    pip install cryptography

Execução:
    python pasta_criptografada_numeros.py

Observação:
- A sequência numérica fica bem maior que o arquivo binário original.
- Para uso real, prefira manter o arquivo gerado, sem copiar e colar
  milhões de dígitos em editores de texto.
"""

from __future__ import annotations

import io
import os
import shutil
import struct
import tempfile
import tkinter as tk
import zipfile

from pathlib import Path
from tkinter import filedialog, messagebox, ttk

from cryptography.exceptions import InvalidTag
from cryptography.hazmat.primitives.ciphers.aead import AESGCM
from cryptography.hazmat.primitives.kdf.scrypt import Scrypt


# ---------------------------------------------------------------------
# Formato do arquivo criptografado
# ---------------------------------------------------------------------
#
# Conteúdo binário antes de virar números:
#
# MAGIC       8 bytes
# VERSÃO      1 byte
# SALT       16 bytes
# NONCE      12 bytes
# TAMANHO     8 bytes
# CIPHERTEXT  tamanho variável, incluindo a tag do AES-GCM
#
# Depois, cada byte é convertido para exatamente 3 dígitos:
#
# 000 001 002 ... 255
#
# Exemplo:
# bytes([1, 35, 255]) -> "001035255"
# ---------------------------------------------------------------------

MAGIC = b"PASTANUM"
VERSAO = 1

TAMANHO_SALT = 16
TAMANHO_NONCE = 12
TAMANHO_CAMPO_TAMANHO = 8

N_SCRYPT = 2**15
R_SCRYPT = 8
P_SCRYPT = 1


def derivar_chave(senha: str, salt: bytes) -> bytes:
    """
    Deriva uma chave AES-256 a partir da senha.

    Scrypt torna tentativas de adivinhação de senha mais caras do que
    usar diretamente SHA-256.
    """
    if not senha:
        raise ValueError("A senha não pode estar vazia.")

    kdf = Scrypt(
        salt=salt,
        length=32,
        n=N_SCRYPT,
        r=R_SCRYPT,
        p=P_SCRYPT,
    )

    return kdf.derive(senha.encode("utf-8"))


def pasta_para_zip_bytes(caminho_pasta: Path) -> bytes:
    """
    Compacta a pasta inteira em memória.

    O diretório raiz também é preservado dentro do ZIP.
    """
    caminho_pasta = caminho_pasta.resolve()

    if not caminho_pasta.is_dir():
        raise ValueError("O caminho selecionado não é uma pasta válida.")

    buffer = io.BytesIO()

    with zipfile.ZipFile(
        buffer,
        mode="w",
        compression=zipfile.ZIP_DEFLATED,
        compresslevel=9,
    ) as arquivo_zip:

        raiz_pai = caminho_pasta.parent

        for caminho in sorted(caminho_pasta.rglob("*")):
            nome_no_zip = caminho.relative_to(raiz_pai)

            if caminho.is_dir():
                # Preserva diretórios vazios.
                info = zipfile.ZipInfo(str(nome_no_zip).replace("\\", "/") + "/")
                arquivo_zip.writestr(info, b"")
            elif caminho.is_file():
                arquivo_zip.write(
                    filename=caminho,
                    arcname=str(nome_no_zip).replace("\\", "/"),
                )

    return buffer.getvalue()


def bytes_para_numeros(dados: bytes) -> str:
    """
    Converte bytes para uma sequência formada apenas por dígitos.

    Cada byte usa exatamente três dígitos, permitindo conversão reversível.
    """
    return "".join(f"{byte:03d}" for byte in dados)


def numeros_para_bytes(texto: str) -> bytes:
    """
    Converte a sequência numérica novamente para bytes.
    """
    numeros = "".join(texto.split())

    if not numeros:
        raise ValueError("O arquivo numérico está vazio.")

    if not numeros.isdigit():
        raise ValueError(
            "O conteúdo possui caracteres que não são números."
        )

    if len(numeros) % 3 != 0:
        raise ValueError(
            "A quantidade de dígitos não é múltipla de 3. "
            "O arquivo pode estar incompleto ou corrompido."
        )

    resultado = bytearray()

    for inicio in range(0, len(numeros), 3):
        valor = int(numeros[inicio:inicio + 3])

        if valor > 255:
            raise ValueError(
                f"Bloco numérico inválido encontrado: {valor:03d}."
            )

        resultado.append(valor)

    return bytes(resultado)


def montar_pacote_criptografado(
    zip_bytes: bytes,
    senha: str,
) -> bytes:
    """
    Criptografa os bytes do ZIP e monta o pacote binário.
    """
    salt = os.urandom(TAMANHO_SALT)
    nonce = os.urandom(TAMANHO_NONCE)

    chave = derivar_chave(
        senha=senha,
        salt=salt,
    )

    aes = AESGCM(chave)

    cabecalho_autenticado = (
        MAGIC
        + bytes([VERSAO])
        + salt
        + nonce
    )

    ciphertext = aes.encrypt(
        nonce=nonce,
        data=zip_bytes,
        associated_data=cabecalho_autenticado,
    )

    tamanho_ciphertext = struct.pack(
        ">Q",
        len(ciphertext),
    )

    return (
        cabecalho_autenticado
        + tamanho_ciphertext
        + ciphertext
    )


def abrir_pacote_criptografado(
    pacote: bytes,
    senha: str,
) -> bytes:
    """
    Valida o formato, deriva a chave e descriptografa o ZIP.
    """
    tamanho_minimo = (
        len(MAGIC)
        + 1
        + TAMANHO_SALT
        + TAMANHO_NONCE
        + TAMANHO_CAMPO_TAMANHO
        + 16  # tag mínima do AES-GCM
    )

    if len(pacote) < tamanho_minimo:
        raise ValueError(
            "O arquivo numérico é pequeno demais ou está corrompido."
        )

    posicao = 0

    magic = pacote[posicao:posicao + len(MAGIC)]
    posicao += len(MAGIC)

    if magic != MAGIC:
        raise ValueError(
            "O arquivo não foi gerado por este programa."
        )

    versao = pacote[posicao]
    posicao += 1

    if versao != VERSAO:
        raise ValueError(
            f"Versão de arquivo não suportada: {versao}."
        )

    salt = pacote[posicao:posicao + TAMANHO_SALT]
    posicao += TAMANHO_SALT

    nonce = pacote[posicao:posicao + TAMANHO_NONCE]
    posicao += TAMANHO_NONCE

    tamanho_ciphertext = struct.unpack(
        ">Q",
        pacote[posicao:posicao + TAMANHO_CAMPO_TAMANHO],
    )[0]
    posicao += TAMANHO_CAMPO_TAMANHO

    ciphertext = pacote[posicao:]

    if len(ciphertext) != tamanho_ciphertext:
        raise ValueError(
            "O tamanho do conteúdo não confere. "
            "O arquivo pode ter sido cortado ou alterado."
        )

    chave = derivar_chave(
        senha=senha,
        salt=salt,
    )

    aes = AESGCM(chave)

    cabecalho_autenticado = (
        MAGIC
        + bytes([VERSAO])
        + salt
        + nonce
    )

    try:
        return aes.decrypt(
            nonce=nonce,
            data=ciphertext,
            associated_data=cabecalho_autenticado,
        )
    except InvalidTag as erro:
        raise ValueError(
            "Senha incorreta ou arquivo alterado/corrompido."
        ) from erro


def extrair_zip_com_seguranca(
    zip_bytes: bytes,
    pasta_destino: Path,
) -> None:
    """
    Extrai o ZIP impedindo caminhos maliciosos que escapem da pasta destino.
    """
    pasta_destino = pasta_destino.resolve()
    pasta_destino.mkdir(
        parents=True,
        exist_ok=True,
    )

    with zipfile.ZipFile(io.BytesIO(zip_bytes), "r") as arquivo_zip:
        for membro in arquivo_zip.infolist():
            destino = (
                pasta_destino
                / membro.filename
            ).resolve()

            try:
                destino.relative_to(pasta_destino)
            except ValueError as erro:
                raise ValueError(
                    "O arquivo ZIP contém um caminho inseguro."
                ) from erro

        arquivo_zip.extractall(pasta_destino)


def criptografar_pasta(
    caminho_pasta: Path,
    caminho_saida: Path,
    senha: str,
) -> None:
    """
    Fluxo completo:
    pasta -> ZIP -> AES-GCM -> sequência numérica -> arquivo texto.
    """
    zip_bytes = pasta_para_zip_bytes(caminho_pasta)

    pacote = montar_pacote_criptografado(
        zip_bytes=zip_bytes,
        senha=senha,
    )

    numeros = bytes_para_numeros(pacote)

    caminho_saida.write_text(
        numeros,
        encoding="ascii",
    )


def descriptografar_para_pasta(
    caminho_arquivo_numerico: Path,
    pasta_destino: Path,
    senha: str,
) -> None:
    """
    Fluxo reverso:
    sequência numérica -> bytes -> AES-GCM -> ZIP -> pasta.
    """
    texto = caminho_arquivo_numerico.read_text(
        encoding="ascii",
    )

    pacote = numeros_para_bytes(texto)

    zip_bytes = abrir_pacote_criptografado(
        pacote=pacote,
        senha=senha,
    )

    extrair_zip_com_seguranca(
        zip_bytes=zip_bytes,
        pasta_destino=pasta_destino,
    )


class AplicativoCriptografia(tk.Tk):
    """
    Interface gráfica em Tkinter.
    """

    def __init__(self) -> None:
        super().__init__()

        self.title(
            "Pasta criptografada em sequência numérica"
        )
        self.geometry("820x520")
        self.minsize(720, 470)

        self.pasta_origem = tk.StringVar()
        self.arquivo_numerico = tk.StringVar()
        self.pasta_destino = tk.StringVar()

        self.senha_criptografar = tk.StringVar()
        self.confirmacao_senha = tk.StringVar()
        self.senha_descriptografar = tk.StringVar()

        self.status = tk.StringVar(
            value="Selecione uma operação."
        )

        self._montar_interface()

    def _montar_interface(self) -> None:
        container = ttk.Frame(
            self,
            padding=18,
        )
        container.pack(
            fill="both",
            expand=True,
        )

        titulo = ttk.Label(
            container,
            text="Criptografia de pasta em números",
            font=("Arial", 18, "bold"),
        )
        titulo.pack(
            anchor="w",
            pady=(0, 6),
        )

        descricao = ttk.Label(
            container,
            text=(
                "A pasta será compactada, criptografada com AES-256-GCM "
                "e salva como uma sequência formada somente por dígitos."
            ),
            wraplength=760,
        )
        descricao.pack(
            anchor="w",
            pady=(0, 14),
        )

        notebook = ttk.Notebook(container)
        notebook.pack(
            fill="both",
            expand=True,
        )

        aba_criptografar = ttk.Frame(
            notebook,
            padding=18,
        )
        aba_descriptografar = ttk.Frame(
            notebook,
            padding=18,
        )

        notebook.add(
            aba_criptografar,
            text="Criptografar pasta",
        )
        notebook.add(
            aba_descriptografar,
            text="Restaurar pasta",
        )

        self._montar_aba_criptografar(
            aba_criptografar
        )
        self._montar_aba_descriptografar(
            aba_descriptografar
        )

        ttk.Separator(
            container
        ).pack(
            fill="x",
            pady=(14, 10),
        )

        ttk.Label(
            container,
            textvariable=self.status,
        ).pack(anchor="w")

    @staticmethod
    def _campo_com_botao(
        pai: ttk.Frame,
        linha: int,
        rotulo: str,
        variavel: tk.StringVar,
        comando,
        texto_botao: str,
    ) -> None:
        ttk.Label(
            pai,
            text=rotulo,
        ).grid(
            row=linha,
            column=0,
            sticky="w",
            pady=(8, 4),
        )

        ttk.Entry(
            pai,
            textvariable=variavel,
        ).grid(
            row=linha + 1,
            column=0,
            sticky="ew",
            padx=(0, 10),
        )

        ttk.Button(
            pai,
            text=texto_botao,
            command=comando,
        ).grid(
            row=linha + 1,
            column=1,
            sticky="ew",
        )

    def _montar_aba_criptografar(
        self,
        aba: ttk.Frame,
    ) -> None:
        aba.columnconfigure(0, weight=1)

        self._campo_com_botao(
            pai=aba,
            linha=0,
            rotulo="Pasta que será criptografada",
            variavel=self.pasta_origem,
            comando=self._selecionar_pasta_origem,
            texto_botao="Selecionar pasta",
        )

        ttk.Label(
            aba,
            text="Senha",
        ).grid(
            row=2,
            column=0,
            sticky="w",
            pady=(16, 4),
        )

        ttk.Entry(
            aba,
            textvariable=self.senha_criptografar,
            show="•",
        ).grid(
            row=3,
            column=0,
            columnspan=2,
            sticky="ew",
        )

        ttk.Label(
            aba,
            text="Confirmar senha",
        ).grid(
            row=4,
            column=0,
            sticky="w",
            pady=(12, 4),
        )

        ttk.Entry(
            aba,
            textvariable=self.confirmacao_senha,
            show="•",
        ).grid(
            row=5,
            column=0,
            columnspan=2,
            sticky="ew",
        )

        ttk.Label(
            aba,
            text=(
                "Use uma senha longa. Sem a senha correta, "
                "não existe mecanismo de recuperação."
            ),
            wraplength=680,
        ).grid(
            row=6,
            column=0,
            columnspan=2,
            sticky="w",
            pady=(10, 16),
        )

        ttk.Button(
            aba,
            text="Criptografar e salvar sequência numérica",
            command=self._executar_criptografia,
        ).grid(
            row=7,
            column=0,
            columnspan=2,
            sticky="ew",
            ipady=8,
        )

    def _montar_aba_descriptografar(
        self,
        aba: ttk.Frame,
    ) -> None:
        aba.columnconfigure(0, weight=1)

        self._campo_com_botao(
            pai=aba,
            linha=0,
            rotulo="Arquivo numérico criptografado",
            variavel=self.arquivo_numerico,
            comando=self._selecionar_arquivo_numerico,
            texto_botao="Selecionar arquivo",
        )

        self._campo_com_botao(
            pai=aba,
            linha=2,
            rotulo="Pasta na qual o conteúdo será restaurado",
            variavel=self.pasta_destino,
            comando=self._selecionar_pasta_destino,
            texto_botao="Selecionar destino",
        )

        ttk.Label(
            aba,
            text="Senha usada na criptografia",
        ).grid(
            row=4,
            column=0,
            sticky="w",
            pady=(16, 4),
        )

        ttk.Entry(
            aba,
            textvariable=self.senha_descriptografar,
            show="•",
        ).grid(
            row=5,
            column=0,
            columnspan=2,
            sticky="ew",
        )

        ttk.Button(
            aba,
            text="Descriptografar e restaurar pasta",
            command=self._executar_descriptografia,
        ).grid(
            row=6,
            column=0,
            columnspan=2,
            sticky="ew",
            pady=(18, 0),
            ipady=8,
        )

    def _selecionar_pasta_origem(self) -> None:
        selecionada = filedialog.askdirectory(
            title="Selecione a pasta para criptografar"
        )

        if selecionada:
            self.pasta_origem.set(
                selecionada
            )

    def _selecionar_arquivo_numerico(self) -> None:
        selecionado = filedialog.askopenfilename(
            title="Selecione o arquivo numérico",
            filetypes=[
                (
                    "Arquivo numérico",
                    "*.numtxt",
                ),
                (
                    "Arquivo de texto",
                    "*.txt",
                ),
                (
                    "Todos os arquivos",
                    "*.*",
                ),
            ],
        )

        if selecionado:
            self.arquivo_numerico.set(
                selecionado
            )

    def _selecionar_pasta_destino(self) -> None:
        selecionada = filedialog.askdirectory(
            title="Selecione a pasta de destino"
        )

        if selecionada:
            self.pasta_destino.set(
                selecionada
            )

    def _executar_criptografia(self) -> None:
        try:
            origem = Path(
                self.pasta_origem.get()
            )

            senha = self.senha_criptografar.get()
            confirmacao = self.confirmacao_senha.get()

            if not origem.is_dir():
                raise ValueError(
                    "Selecione uma pasta de origem válida."
                )

            if senha != confirmacao:
                raise ValueError(
                    "A senha e a confirmação não coincidem."
                )

            if len(senha) < 8:
                raise ValueError(
                    "Use uma senha com pelo menos 8 caracteres."
                )

            sugestao = (
                origem.parent
                / f"{origem.name}.numtxt"
            )

            destino = filedialog.asksaveasfilename(
                title="Salvar sequência numérica",
                initialfile=sugestao.name,
                initialdir=str(sugestao.parent),
                defaultextension=".numtxt",
                filetypes=[
                    (
                        "Arquivo numérico criptografado",
                        "*.numtxt",
                    ),
                    (
                        "Arquivo de texto",
                        "*.txt",
                    ),
                ],
            )

            if not destino:
                return

            self.status.set(
                "Compactando e criptografando..."
            )
            self.update_idletasks()

            criptografar_pasta(
                caminho_pasta=origem,
                caminho_saida=Path(destino),
                senha=senha,
            )

            tamanho = Path(destino).stat().st_size

            self.status.set(
                f"Arquivo criado: {destino}"
            )

            messagebox.showinfo(
                "Concluído",
                (
                    "Pasta criptografada com sucesso.\n\n"
                    f"Arquivo: {destino}\n"
                    f"Tamanho: {tamanho:,} bytes\n\n"
                    "Guarde a senha separadamente."
                ),
            )

        except Exception as erro:
            self.status.set(
                "Falha na criptografia."
            )
            messagebox.showerror(
                "Erro",
                str(erro),
            )

    def _executar_descriptografia(self) -> None:
        try:
            arquivo = Path(
                self.arquivo_numerico.get()
            )

            destino = Path(
                self.pasta_destino.get()
            )

            senha = self.senha_descriptografar.get()

            if not arquivo.is_file():
                raise ValueError(
                    "Selecione um arquivo numérico válido."
                )

            if not destino.is_dir():
                raise ValueError(
                    "Selecione uma pasta de destino válida."
                )

            if not senha:
                raise ValueError(
                    "Informe a senha."
                )

            self.status.set(
                "Lendo, descriptografando e restaurando..."
            )
            self.update_idletasks()

            descriptografar_para_pasta(
                caminho_arquivo_numerico=arquivo,
                pasta_destino=destino,
                senha=senha,
            )

            self.status.set(
                f"Conteúdo restaurado em: {destino}"
            )

            messagebox.showinfo(
                "Concluído",
                (
                    "Conteúdo restaurado com sucesso.\n\n"
                    f"Destino: {destino}"
                ),
            )

        except Exception as erro:
            self.status.set(
                "Falha na restauração."
            )
            messagebox.showerror(
                "Erro",
                str(erro),
            )


def main() -> None:
    aplicativo = AplicativoCriptografia()
    aplicativo.mainloop()


if __name__ == "__main__":
    main()


